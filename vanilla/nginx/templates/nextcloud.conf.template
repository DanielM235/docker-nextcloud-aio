# Nextcloud vhost (vanilla configuration) — robust, hardened reverse proxy
#
# The app container runs the `nextcloud:<version>-apache` image and only speaks
# plain HTTP; nginx terminates TLS and proxies everything to it.  This config
# follows the official Nextcloud hardening guidance (security headers, HSTS,
# upload limits) and the Mozilla "intermediate" TLS profile.
#
# Variables (expanded at runtime via envsubst):
#   ${NGINX_SERVER_NAME} — domain served (e.g. nextcloud.example.com)
#   ${NGINX_APP_PORT}    — loopback port of the app container (APP_HTTP_PORT)
#   ${NGINX_SSL_CERT}    — fullchain certificate path
#   ${NGINX_SSL_KEY}     — private key path
#   ${NGINX_DHPARAM}     — Diffie-Hellman parameters file
#
# Production installation on Debian 12 / Ubuntu 24.04:
#   export NGINX_SERVER_NAME=nextcloud.example.com
#   export NGINX_APP_PORT=8080
#   export NGINX_SSL_CERT=/etc/letsencrypt/live/nextcloud.example.com/fullchain.pem
#   export NGINX_SSL_KEY=/etc/letsencrypt/live/nextcloud.example.com/privkey.pem
#   export NGINX_DHPARAM=/etc/nginx/dhparam
#   envsubst '${NGINX_SERVER_NAME} ${NGINX_APP_PORT} ${NGINX_SSL_CERT} ${NGINX_SSL_KEY} ${NGINX_DHPARAM}' \
#     < nginx/templates/nextcloud.conf.template \
#     > /etc/nginx/sites-available/nextcloud
#   ln -sf /etc/nginx/sites-available/nextcloud /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
#
# Generate the DH parameters once (before the first reload):
#   openssl dhparam -out /etc/nginx/dhparam 2048

# Map the HTTP Upgrade header to a Connection value for WebSocket proxying
# (Nextcloud Talk, notifications).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# --- HTTP → HTTPS ------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;            # comment to disable IPv6
    server_name ${NGINX_SERVER_NAME};

    # Redirect to HTTPS.  The second rule also handles the case where we sit
    # behind another proxy that sets X-Forwarded-Proto.
    if ($scheme = "http") {
        return 301 https://$host$request_uri;
    }
    if ($http_x_forwarded_proto = "http") {
        return 301 https://$host$request_uri;
    }
}

# --- HTTPS -------------------------------------------------------------------
server {
    listen 443 ssl http2;      # for nginx versions below v1.25.1
    listen [::]:443 ssl http2; # for nginx versions below v1.25.1 — comment to disable IPv6
    # listen 443 ssl;          # for nginx v1.25.1+
    # listen [::]:443 ssl;     # for nginx v1.25.1+
    # http2 on;                # for nginx v1.25.1+

    server_name ${NGINX_SERVER_NAME};

    # Do not advertise the nginx version.
    server_tokens off;

    # -------------------------------------------------------
    # TLS — Mozilla "intermediate" profile.
    # Let's Encrypt ended OCSP (Dec 2025): keep stapling disabled.
    # -------------------------------------------------------
    ssl_certificate     ${NGINX_SSL_CERT};
    ssl_certificate_key ${NGINX_SSL_KEY};
    ssl_dhparam         ${NGINX_DHPARAM};

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ecdh_curve X25519:secp521r1:secp384r1:prime256v1;
    ssl_session_timeout  1d;
    ssl_session_cache    shared:SSL:10m;
    ssl_session_tickets  off;
    ssl_prefer_server_ciphers on;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;

    # -------------------------------------------------------
    # Security headers
    # -------------------------------------------------------
    # HSTS — add "preload" only after reading https://hstspreload.org/
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Permitted-Cross-Domain-Policies "none" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Robots-Tag "noindex, nofollow" always;

    # Do not leak the upstream (Apache) or PHP versions.
    proxy_hide_header Server;
    proxy_hide_header X-Powered-By;

    # -------------------------------------------------------
    # Uploads / buffering / timeouts
    # -------------------------------------------------------
    # 0 = unlimited; the effective upload limit is PHP_UPLOAD_LIMIT in the app.
    client_max_body_size 0;
    client_body_buffer_size 512k;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_connect_timeout 60s;
    proxy_read_timeout    3600s;
    proxy_send_timeout    3600s;

    # -------------------------------------------------------
    # Service discovery (CardDAV / CalDAV) — do not proxy these.
    # -------------------------------------------------------
    location = /.well-known/carddav { return 301 /remote.php/dav/; }
    location = /.well-known/caldav  { return 301 /remote.php/dav/; }
    # Only needed if Certbot uses the HTTP-01 challenge on this vhost.
    # location ^~ /.well-known/acme-challenge { try_files $uri =404; }

    # -------------------------------------------------------
    # Everything else → the app container (Apache).
    # -------------------------------------------------------
    location / {
        proxy_pass http://127.0.0.1:${NGINX_APP_PORT};

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  $server_port;

        # WebSocket (Talk / notifications)
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

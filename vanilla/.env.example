# ============================================================
#  Nextcloud (vanilla) — Environment Variables
#
#  Copy to .env and fill in the secrets before the first run:
#
#      cp .env.example .env
#
#  IMPORTANT: Never commit .env.  This file is safe to commit —
#  it contains only generic, non-secret defaults.
#
#  This is the "vanilla" configuration built on the official
#  nextcloud image + MariaDB + Redis (no Docker socket access).
# ============================================================


# ------------------------------------------------------------
# Compose project name
#
# Prefix for container, volume and network names so multiple
# instances can coexist on one host.  Lowercase letters, digits
# and hyphens only.
# ------------------------------------------------------------
COMPOSE_PROJECT_NAME=nextcloud-vanilla


# ------------------------------------------------------------
# Image versions (pinned — see docs/UPDATE.md when upgrading)
#
# NEXTCLOUD_IMAGE_TAG — official nextcloud image (apache variant).
#   Upgrade one major version at a time.
# MARIADB_IMAGE_TAG   — MariaDB LTS line.
# REDIS_IMAGE_TAG     — Redis.
# PULL_POLICY         — always | if_not_present | never
# ------------------------------------------------------------
NEXTCLOUD_IMAGE_TAG=34.0.3-apache
MARIADB_IMAGE_TAG=11.4
REDIS_IMAGE_TAG=7-alpine
PULL_POLICY=if_not_present


# ------------------------------------------------------------
# Domain / networking
#
# DOMAIN_NAME     — public hostname (no protocol).  Must match the
#                   nginx server_name and the Nextcloud trusted domain.
# APP_HTTP_PORT   — loopback port the app container publishes; the
#                   host nginx proxies HTTPS to 127.0.0.1:APP_HTTP_PORT.
# OVERWRITECLIURL — base URL Nextcloud reports to clients.
# ------------------------------------------------------------
DOMAIN_NAME=nextcloud.example.com
APP_HTTP_PORT=8080
OVERWRITECLIURL=https://nextcloud.example.com


# ------------------------------------------------------------
# Secrets — REQUIRED, must be changed
#
# Generated automatically by './setup.sh install'.  Use long
# random strings; never commit them.
# ------------------------------------------------------------
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD


# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud


# ------------------------------------------------------------
# Initial admin account
#
# Optional: set BOTH to auto-install Nextcloud and skip the web
# wizard on first run.  Leave empty to create the admin through
# the web UI on first login.
# ------------------------------------------------------------
NEXTCLOUD_ADMIN_USER=
NEXTCLOUD_ADMIN_PASSWORD=


# ------------------------------------------------------------
# Data directory (external disk)
#
# NEXTCLOUD_DATA_DIR — HOST path (bind mount) where Nextcloud
#   stores user files.  Point it at an external disk mountpoint
#   (e.g. /mnt/nextcloud-data).  './setup.sh install' creates and
#   chowns it to www-data (uid 33) — mount the disk first.
# ------------------------------------------------------------
NEXTCLOUD_DATA_DIR=/mnt/nextcloud-data


# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------
REDIS_HOST=redis
# REDIS_HOST_PASSWORD=


# ------------------------------------------------------------
# PHP / upload tuning
# ------------------------------------------------------------
PHP_MEMORY_LIMIT=512M
PHP_UPLOAD_LIMIT=16G
# 0 = unlimited request body (upload limit is governed by PHP_UPLOAD_LIMIT).
APACHE_BODY_LIMIT=0


# ------------------------------------------------------------
# Resource limits (CPU / memory)
# ------------------------------------------------------------
DB_CPU_LIMIT=2.0
DB_MEM_LIMIT=1g
REDIS_CPU_LIMIT=0.5
REDIS_MEM_LIMIT=256m
APP_CPU_LIMIT=2.0
APP_MEM_LIMIT=1g
CRON_CPU_LIMIT=0.5
CRON_MEM_LIMIT=512m


# ------------------------------------------------------------
# Restart & logging
# ------------------------------------------------------------
RESTART_POLICY=unless-stopped
LOG_DRIVER=json-file
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5


# ------------------------------------------------------------
# Backup
#
# BACKUP_DIR            — directory (relative to this config) for
#                         backups created by './setup.sh backup'.
# BACKUP_RETENTION_DAYS — keep backups this many days.
# ------------------------------------------------------------
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30

# ============================================================
#  Nextcloud AIO — Environment Variables
#
#  Copy this file to .env and adjust the values before running
#  the stack for the first time:
#
#      cp .env.example .env
#
#  IMPORTANT: Never commit .env to version control.
#  This file is safe to commit — it contains only generic,
#  non-secret defaults.
# ============================================================


# ------------------------------------------------------------
# Compose project name
#
# Prefix used for the Docker Compose *project* (the top-level
# "name:" field).  Note: Nextcloud AIO uses fixed container and
# volume names internally (nextcloud-aio-mastercontainer and
# nextcloud_aio_mastercontainer) that cannot be changed, so this
# value does NOT rename AIO's own containers.  It only scopes this
# Compose project and the helper test containers.
# ------------------------------------------------------------
COMPOSE_PROJECT_NAME=nextcloud-aio


# ------------------------------------------------------------
# AIO image channel
#
# AIO_IMAGE_REGISTRY — container registry (change only if you
#                      mirror the images).
# AIO_IMAGE_TAG      — release channel.  Nextcloud AIO ships
#                      rolling channels, not semantic versions:
#                        latest  → stable channel (recommended)
#                        beta    → early testing
#                        develop → bleeding edge
# PULL_POLICY        — image pull policy:
#                      always | if_not_present | never
# ------------------------------------------------------------
AIO_IMAGE_REGISTRY=ghcr.io/nextcloud-releases
AIO_IMAGE_TAG=latest
PULL_POLICY=if_not_present


# ------------------------------------------------------------
# Docker socket
#
# DOCKER_SOCKET_PATH          — host path of the Docker socket that
#                               the mastercontainer mounts (read-only)
#                               to orchestrate the other AIO
#                               containers.
# WATCHTOWER_DOCKER_SOCKET_PATH — must match DOCKER_SOCKET_PATH so
#                               mastercontainer self-updates work.
#                               On a standard Linux host both are
#                               /var/run/docker.sock.
# ------------------------------------------------------------
DOCKER_SOCKET_PATH=/var/run/docker.sock
WATCHTOWER_DOCKER_SOCKET_PATH=/var/run/docker.sock


# ------------------------------------------------------------
# Domain / networking
#
# DOMAIN_NAME  — public hostname of the Nextcloud instance (no
#                protocol, no trailing slash).  You enter the SAME
#                domain in the AIO web interface during first setup.
# APACHE_PORT  — host port that AIO's Apache container publishes.
#                Your reverse proxy forwards HTTPS to this port.
# APACHE_IP_BINDING — interface the Apache container listens on.
#                127.0.0.1 when the reverse proxy runs on the same
#                host; 0.0.0.0 when it runs on another machine.
# APACHE_ADDITIONAL_NETWORK — optional: name of an extra Docker
#                network to attach AIO's Apache container to (needed
#                when your reverse proxy is itself a container in
#                another network).  Leave empty otherwise.
# ------------------------------------------------------------
DOMAIN_NAME=nextcloud.example.com
APACHE_PORT=11000
APACHE_IP_BINDING=127.0.0.1
APACHE_ADDITIONAL_NETWORK=


# ------------------------------------------------------------
# AIO web interface (mastercontainer, self-signed certificate)
#
# AIO_INTERFACE_PORT      — host port mapped to the container's
#                           HTTPS :8080.  Bound to loopback by
#                           default; reach it via an SSH tunnel or
#                           through your reverse proxy (see
#                           docs/REVERSE_PROXY.md).
# AIO_INTERFACE_BIND_HOST — interface to bind.  127.0.0.1 = local
#                           only (recommended); 0.0.0.0 = expose on
#                           the LAN (not recommended).
# AIO_ADMIN_HOSTNAME      — dedicated hostname under which your
#                           reverse proxy exposes the AIO interface
#                           (used by nginx/templates/aio-admin.conf.template).
# ------------------------------------------------------------
AIO_INTERFACE_PORT=8080
AIO_INTERFACE_BIND_HOST=127.0.0.1
AIO_ADMIN_HOSTNAME=aio.example.com


# ------------------------------------------------------------
# Domain validation
#
# SKIP_DOMAIN_VALIDATION — set to true only if you are certain the
#                           domain is correctly configured but AIO
#                           cannot validate it (e.g. behind a
#                           Cloudflare tunnel or when using the ACME
#                           DNS challenge).  Keep false otherwise.
# ------------------------------------------------------------
SKIP_DOMAIN_VALIDATION=false


# ------------------------------------------------------------
# Nextcloud tuning (optional — leave empty/unchanged for defaults)
#
# NEXTCLOUD_DATADIR  — host path (or Docker volume name) to use as
#                      Nextcloud's data directory.  WARNING: do not
#                      set or change this after the first install.
#                      Leave empty to keep the default named volume.
# NEXTCLOUD_MOUNT    — host directory to mount into the Nextcloud
#                      container (for local external storage).
# NEXTCLOUD_UPLOAD_LIMIT — max upload size for public shares, e.g.
#                      16G (logged-in users can upload more via
#                      chunking).
# NEXTCLOUD_MAX_TIME — max execution time in seconds (3600 default).
# NEXTCLOUD_MEMORY_LIMIT — PHP memory limit per process (512M).
# NEXTCLOUD_STARTUP_APPS — extra apps to install on first start
#                      (space-separated app ids).
# NEXTCLOUD_ADDITIONAL_APKS — extra Alpine packages for the
#                      Nextcloud container (AIO default: imagemagick).
# NEXTCLOUD_ADDITIONAL_PHP_EXTENSIONS — extra PHP extensions
#                      (AIO default: imagick).
# NEXTCLOUD_KEEP_DISABLED_APPS — true keeps apps disabled in the AIO
#                      interface instead of uninstalling them.
# NEXTCLOUD_TRUSTED_CACERTS_DIR — host dir with extra CA certs to
#                      trust inside the Nextcloud container (e.g. for
#                      LDAPS with self-signed certs).
# NEXTCLOUD_ENABLE_NVIDIA_GPU — true enables NVIDIA GPU acceleration
#                      (requires the NVIDIA Container Toolkit).
# ------------------------------------------------------------
NEXTCLOUD_DATADIR=
NEXTCLOUD_MOUNT=
NEXTCLOUD_UPLOAD_LIMIT=16G
NEXTCLOUD_MAX_TIME=3600
NEXTCLOUD_MEMORY_LIMIT=512M
NEXTCLOUD_STARTUP_APPS=
NEXTCLOUD_ADDITIONAL_APKS=imagemagick
NEXTCLOUD_ADDITIONAL_PHP_EXTENSIONS=imagick
NEXTCLOUD_KEEP_DISABLED_APPS=false
NEXTCLOUD_TRUSTED_CACERTS_DIR=
NEXTCLOUD_ENABLE_NVIDIA_GPU=false


# ------------------------------------------------------------
# Backup (built-in Borg)
#
# AIO_DISABLE_BACKUP_SECTION — true hides the backup section in the
#                      AIO interface (only if you have an external
#                      backup solution).
# BORG_RETENTION_POLICY — retention for AIO's built-in Borg backups.
#                      Leave empty for the AIO default:
#                      "--keep-within=7d --keep-weekly=4 --keep-monthly=6".
# ------------------------------------------------------------
AIO_DISABLE_BACKUP_SECTION=false
BORG_RETENTION_POLICY=


# ------------------------------------------------------------
# Logging / diagnostics
#
# AIO_LOG_LEVEL — global log level of the AIO components:
#                 error | warn | info | debug
# DOCKER_API_VERSION — override the internally used Docker API
#                 version (leave empty to use the tested default).
# COLLABORA_SECCOMP_DISABLED — true only if your kernel lacks the
#                 seccomp feature needed by Nextcloud Office.
# FULLTEXTSEARCH_JAVA_OPTIONS — JVM options for full-text search.
#                 Leave empty for the default "-Xms512M -Xmx512M".
# TALK_PORT — host port for Nextcloud Talk TURN (TCP + UDP).
# ------------------------------------------------------------
AIO_LOG_LEVEL=warn
DOCKER_API_VERSION=
COLLABORA_SECCOMP_DISABLED=false
FULLTEXTSEARCH_JAVA_OPTIONS=
TALK_PORT=3478


# ------------------------------------------------------------
# Resource limits (mastercontainer)
#
# Hard caps applied via deploy.resources.limits.  The mastercontainer
# is a lightweight orchestrator + web UI, so defaults are modest.
# CPU is in cores (fractional allowed); memory accepts b/k/m/g.
# ------------------------------------------------------------
AIO_CPU_LIMIT=1.0
AIO_MEM_LIMIT=1g
AIO_PIDS_LIMIT=256


# ------------------------------------------------------------
# Restart & logging
# ------------------------------------------------------------
RESTART_POLICY=unless-stopped
LOG_DRIVER=json-file
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5
